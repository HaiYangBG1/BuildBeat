{
  "name": "solobaton",
  "version": "1.16.3",
  "description": "File-first, human-gated delivery bus for solo builders orchestrating multiple AI coding sessions.",
  "type": "module",
  "bin": {
    "solobaton": "bin/solobaton.js"
  },
  "files": [
    "bin/",
    "docs/",
    "example/",
    "src/",
    "templates/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.en.md",
    "SKILL.md",
    "lessons.md"
  ],
  "scripts": {
    "check:docs": "bash tests/check-docs.sh",
    "test": "node --test tests/*.test.js",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run check:docs && npm run pack:check"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaiYangBG1/solobaton.git"
  },
  "homepage": "https://github.com/HaiYangBG1/solobaton#readme",
  "bugs": {
    "url": "https://github.com/HaiYangBG1/solobaton/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai-coding",
    "file-first",
    "human-in-the-loop",
    "scaffold",
    "software-delivery",
    "solo-builder"
  ],
  "author": "HaiYangBG",
  "license": "MIT"
}
