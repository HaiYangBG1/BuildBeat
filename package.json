{
  "name": "@haiyangbg/buildbeat",
  "version": "2.0.0-beta.1",
  "description": "BuildBeat: a Git-based, human-gated engineering delivery protocol for humans and AI sessions.",
  "type": "module",
  "bin": {
    "buildbeat": "bin/buildbeat.js",
    "buildbeat-v2": "bin/buildbeat-v2.js",
    "solobaton": "bin/solobaton.js"
  },
  "files": [
    "bin/",
    "docs/",
    "example/",
    "src/",
    "templates/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.en.md",
    "SKILL.md",
    "lessons.md"
  ],
  "scripts": {
    "check:docs": "bash tests/check-docs.sh",
    "test": "node --test tests/*.test.js",
    "test:scripts": "bash tests/test-scripts.sh",
    "test:pilot": "bash tests/pilot-loop.test.sh",
    "test:skill-only": "bash tests/skill-only.test.sh",
    "test:plugin": "bash tests/plugin-marketplace.test.sh",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run test:scripts && npm run test:pilot && npm run test:skill-only && npm run test:plugin && npm run check:docs && npm run pack:check"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaiYangBG1/BuildBeat.git"
  },
  "homepage": "https://github.com/HaiYangBG1/BuildBeat#readme",
  "bugs": {
    "url": "https://github.com/HaiYangBG1/BuildBeat/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai-coding",
    "file-first",
    "human-in-the-loop",
    "scaffold",
    "software-delivery",
    "delivery-protocol",
    "ai-sessions",
    "git-workflow"
  ],
  "author": "HaiYangBG",
  "license": "MIT"
}
