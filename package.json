{
  "name": "@haiyangbg/buildbeat",
  "version": "3.3.1",
  "description": "BuildBeat: Git-based AI delivery across models, tools, sessions, and people, with context in project files, build-test-review-fix loops, and human decisions.",
  "type": "module",
  "bin": {
    "buildbeat": "bin/buildbeat.js"
  },
  "files": [
    "bin/",
    "docs/README.md",
    "docs/CAPABILITY-MATRIX.md",
    "docs/RELEASING.md",
    "docs/v2/",
    "!docs/v2/M[124]-*.md",
    "example/",
    "src/",
    "templates/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.en.md",
    "SKILL.md",
    "lessons.md"
  ],
  "scripts": {
    "check:docs": "bash tests/check-docs.sh",
    "test": "node --test tests/*.test.js",
    "test:envelope": "bash tests/envelope-worker.test.sh",
    "test:plugin": "bash tests/plugin-marketplace.test.sh",
    "test:pack-firstrun": "bash tests/pack-firstrun.test.sh",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run test:envelope && npm run test:plugin && npm run test:pack-firstrun && npm run check:docs && npm run pack:check"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaiYangBG1/BuildBeat.git"
  },
  "homepage": "https://github.com/HaiYangBG1/BuildBeat#readme",
  "bugs": {
    "url": "https://github.com/HaiYangBG1/BuildBeat/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai-coding",
    "git-workflow",
    "project-context",
    "session-handoff",
    "human-in-the-loop",
    "software-delivery",
    "delivery-runtime",
    "ai-agents",
    "team-collaboration"
  ],
  "author": "HaiYangBG",
  "license": "MIT"
}
